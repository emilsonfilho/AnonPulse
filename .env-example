# MongoDB Local via Docker
MONGODB_ROOT_USERNAME=root
MONGODB_ROOT_PASSWORD=password
DATABASE_URL=mongodb://root:password@mongo:27017/anonpulse?authSource=admin
DATABASE_NAME=anonpulse

# MongoDB Atlas na Nuvem
# DATABASE_URL=mongodb+srv://<usuario>:<senha>@cluster.mongodb.net/anonpulse?retryWrites=true&w=majority

MINIO_BUCKET_NAME=anonpulse-documents
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
